  - {fileID: 21300000, guid: 037b00e22542cf743b9d582bbd877fb0, type: 3}
  - {fileID: 21300000, guid: 0e906687010b5f64288688e361f835c1, type: 3}
  - {fileID: 21300000, guid: 7cb97d4ddeda178498b71d167e1a070c, type: 3}
  - {fileID: 21300000, guid: 6bf16b5a0bb940c4b9f908667f74a0d4, type: 3}
  - {fileID: 21300000, guid: 618c44621c8c8e542bf0721f9a1fa497, type: 3}
  - {fileID: 21300000, guid: 22f02486498b3244eb510aed17f4e8fe, type: 3}
  - {fileID: 21300000, guid: e710fadbe153a39418d02667db672e65, type: 3}
  targetText: {fileID: 915072550}
  tutorialTexts:
  - "\u3053\u308C\u304C\u3053\u306E\u30B2\u30FC\u30E0\u306E\u30D7\u30EC\u30A4\u753B\u9762\u3067\u3059\u3002\\n\u2190\u2191\u2192\u30AD\u30FC\u3067\u30B8\u30E3\u30F3\u30D7\u3068\u79FB\u52D5\u3092\u884C\u3044\u307E\u3059\u3002Z\u30AD\u30FC\u3067\u30AD\u30C3\u30AF\u3001X\u30AD\u30FC\u3067\u30ED\u30FC\u30EA\u30F3\u30B0\u3092\u884C\u3044\u307E\u3059\u3002"
  - "HP\u306F\u8D64\u4E38\u3067\u56F2\u307E\u308C\u305F\u30CF\u30FC\u30C8\u30DE\u30FC\u30AF\u3067\u5224\u65AD\u3067\u304D\u307E\u3059\u3002\\n\u6575\u306F\u565B\u307F\u3064\u3044\u3066\u653B\u6483\u3057\u3066\u304F\u308B\u306E\u3067\u3001\u305D\u306E\u653B\u6483\u3092\u53D7\u3051\u308B\u3068HP\u304C\u6E1B\u308A\u307E\u3059\u3002\u6575\u306EHP\u306F\u6575\u306E\u4E0A\u306E\u8584\u7DD1\u8272\u306E\u30B2\u30FC\u30B8\u3067\u78BA\u8A8D\u3057\u307E\u3059\u3002HP\u306F\u30D1\u30F3\u306B\u89E6\u308C\u308B\u3068\u56DE\u5FA9\u3057\u307E\u3059\u3002."
  - "\u8D64\u4E38\u3067\u56F2\u307E\u308C\u305F\u5185\u306E\u30CF\u30FC\u30C8\u30DE\u30FC\u30AF\u306E\u6A2A\u306E\u6570\u5024\u3067\u3082HP\u3092\u78BA\u8A8D\u3067\u304D\u307E\u3059\u3002\\n\u5263\u306E\u30DE\u30FC\u30AF\u306E\u6A2A\u306E\u6570\u5024\u306F\u3001\u653B\u6483\u529B\u3067\u3059\u3002\u30ED\u30FC\u30EA\u30F3\u30B0\u3001\u30AD\u30C3\u30AF\u767A\u52D5\u6642\u306E\u653B\u6483\u529B\u3092\u793A\u3057\u307E\u3059\u3002"
  - "\u8D64\u67A0\u3067\u56F2\u307E\u308C\u305F\u5185\u306E\u9854\u307F\u305F\u3044\u306A\u30DE\u30FC\u30AF\u306E\u6A2A\u306E\u6570\u5024\u306F\u30ED\u30FC\u30EA\u30F3\u30B0\u306E\u30AF\u30FC\u30EB\u30BF\u30A4\u30E0\u3001\u8DB3\u306E\u30DE\u30FC\u30AF\u306E\u6A2A\u306E\u6570\u5024\u306F\u30AD\u30C3\u30AF\u306E\u30AF\u30FC\u30EB\u30BF\u30A4\u30E0\u3067\u3059\u3002\\n\u753B\u50CF\u306E\u30AD\u30C3\u30AF\u30A2\u30A4\u30B3\u30F3\u306E\u69D8\u306B\u30A2\u30A4\u30B3\u30F3\u306B\u30D0\u30C4\u304C\u3064\u3044\u3066\u3044\u308B\u3068\u305D\u306E\u30B9\u30AD\u30EB\u306F\u4F7F\u3048\u307E\u305B\u3093\u3002"
  - "\u8D64\u67A0\u3067\u56F2\u307E\u308C\u305F\u306E\u304C\u30D7\u30EC\u30A4\u30E4\u30FC\u3067\u3001\u30AD\u30C3\u30AF\u3092\u3057\u3066\u3044\u307E\u3059\u3002\u30AD\u30C3\u30AF\u306F\u524D\u65B9\u306E\u6575\u306B\u5411\u304B\u3063\u3066\u653B\u6483\u3092\u3057\u307E\u3059\u3002\u3082\u3046\u4E00\u3064\u306E\u30B9\u30AD\u30EB\u306E\u30ED\u30FC\u30EA\u30F3\u30B0\u306F\u4E00\u5B9A\u6642\u9593\u81EA\u52D5\u3067\u524D\u9032\u3057\u3001\u8FD1\u304F\u306E\u6575\u306B\u653B\u6483\u3057\u307E\u3059\u3002\u305F\u3060\u3057\u3001\u6575\u306E\u653B\u6483\u3092\u53D7\u3051\u308B\u3068\u4E2D\u65AD\u3055\u308C\u307E\u3059\u3002"
  - "\u8D64\u67A0\u3067\u56F2\u307E\u308C\u3066\u3044\u308B\u306E\u304CEXP\u30B2\u30FC\u30B8\u3067\u3059\u3002\u6575\u306E\u6483\u7834\u3067\u5897\u52A0\u3057\u30B2\u30FC\u30B8\u304CMAX\u306B\u306A\u3089\u306A\u3044\u3068\u30B4\u30FC\u30EB\u304C\u3067\u304D\u307E\u305B\u3093\u3002\\n\u6575\u306B\u3088\u3063\u3066\u624B\u306B\u5165\u308BEXP\u306E\u91CF\u306F\u7570\u306A\u308A\u307E\u3059\u3002"
  - "\u3053\u306E\u753B\u50CF\u306E\u6240\u304C\u30B4\u30FC\u30EB\u3067\u3001\u767D\u3044\u30A8\u30EA\u30A2\u306B\u5165\u308B\u3068\u30AF\u30EA\u30A2\u3067\u3059\u3002\\n\u524D\u65B9\u306E\u5CA9\u306B\u5411\u304B\u3063\u3066\u30AD\u30C3\u30AF\u3057\u3066\u7834\u58CA\u3059\u308B\u3053\u3068\u3067\u767D\u3044\u30A8\u30EA\u30A2\u3078\u306E\u9053\u3092\u5207\u308A\u958B\u304F\u3053\u3068\u304C\u3067\u304D\u307E\u3059\u3002\u305F\u3060\u3057\u3001EXP\u304CMax\u3067\u306A\u3044\u3068\u5CA9\u3092\u7834\u58CA\u3067\u304D\u307E\u305B\u3093\u3002"
